<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>dredge</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>IDE0290</NoWarn>
    <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(IsPack)' != 'true' ">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(IsPack)' != 'true' and '$(PublishAot)' != 'true' ">
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(IsPack)' == 'true' ">
    <PublishAot>false</PublishAot>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(PublishAot)' == 'true' ">
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2104;IL3050</WarningsAsErrors>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dredge</ToolCommandName>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Valleysoft.Dredge</PackageId>
    <Title>Container Registry Client CLI</Title>
    <Description>CLI for executing commands on a container registry's HTTP API.</Description>
    <PackageTags>docker;container</PackageTags>
    <Authors>Matt Thalman and Contributors</Authors>
    <RepositoryUrl>https://github.com/mthalman/dredge</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Valleysoft.Dredge.Analyzers/Valleysoft.Dredge.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Valleysoft.Dredge.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="8.0.0" PrivateAssets="all" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="System.CommandLine" Version="2.0.12" />
    <PackageReference Include="Terminal.Gui" Version="2.5.0" />
    <!--
      The explorer does not use Terminal.Gui's Markdown or syntax-highlighting views.
      Excluding their dependencies saves about 7.5 MB and a native library per platform.
      The test project excludes them too, so the explorer UI tests run without them.
    -->
    <PackageReference Include="Markdig" Version="1.4.0" ExcludeAssets="runtime" />
    <PackageReference Include="Onigwrap" Version="1.0.11" ExcludeAssets="all" />
    <PackageReference Include="TextMateSharp" Version="2.0.4" ExcludeAssets="runtime" />
    <PackageReference Include="TextMateSharp.Grammars" Version="2.0.4" ExcludeAssets="runtime" />
    <PackageReference Include="Valleysoft.DockerCredsProvider" Version="3.0.0" />
    <PackageReference Include="Valleysoft.DockerfileModel" Version="3.0.0" />
    <PackageReference Include="Valleysoft.DockerRegistryClient" Version="8.0.0" />
  </ItemGroup>

</Project>
